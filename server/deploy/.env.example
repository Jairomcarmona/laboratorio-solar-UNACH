# Copia a .env (chmod 600) y completa. NUNCA subas .env al repositorio.
LABSOLAR_BANK=lab1
LABSOLAR_DB_PASSWORD=cambia-esto-por-una-clave-larga-y-aleatoria
LABSOLAR_ADMIN_USER=admin
LABSOLAR_ADMIN_PASSWORD=cambia-esto-minimo-12-caracteres
LABSOLAR_ALLOWED_ORIGINS=https://laboratorio.ejemplo.unach.mx
LABSOLAR_COOKIE_SECURE=true
# Contraseñas MQTT: generarlas con deploy/mosquitto/gen-passwd.sh
MQTT_PASSWORD_BRIDGE=
MQTT_PASSWORD_GATEWAY=
MQTT_PASSWORD_RECORDER=
MQTT_PASSWORD_TWIN=
MQTT_PASSWORD_DAQ=            # solo si la adquisición publica por MQTT (equipo Windows con el cDAQ)
# PLC (solo el puente lo usa; red de campo aislada)
PLC_HOST=192.168.50.10
PLC_KIND=modbus
# Cámaras
CAM1_HOST=192.168.60.11
CAM1_USER=
CAM1_PASSWORD=
CAM2_HOST=192.168.60.12
CAM2_USER=
CAM2_PASSWORD=
